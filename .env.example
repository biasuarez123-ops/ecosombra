PORT=3000
SESSION_SECRET=defina_uma_chave_secreta_aleatoria_aqui
# Em produção (Render / Supabase / Neon), preencha DATABASE_URL com a URL do PostgreSQL fornecida pelo serviço.
# Se omitido em ambiente local, o sistema utilizará o banco de dados local SQLite de forma transparente.
# DATABASE_URL=postgresql://usuario:senha@host:5432/ecosombra

# Credenciais seguras para inicialização do Administrador (definidas exclusivamente por variáveis de ambiente)
ADMIN_NAME=Administrador EcoSombra
ADMIN_EMAIL=admin@exemplo.com
ADMIN_INITIAL_PASSWORD=defina_uma_senha_forte_aqui
